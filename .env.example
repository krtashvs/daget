# ─────────────────────────────────────────────────────────────
# Supabase — Project Settings → API (Data API)
# ─────────────────────────────────────────────────────────────
# Project URL, contoh: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (legacy "anon public") ATAU publishable key (sb_publishable_...)
# Aman untuk diekspos ke browser: semua akses dijaga RLS + RPC di schema.sql
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Opsional — pencarian GIF (https://developers.giphy.com/dashboard/)
# Server-only, tidak pernah dikirim ke browser.
# Jika kosong, tombol GIF tetap berfungsi untuk upload file .gif.
# ─────────────────────────────────────────────────────────────
GIPHY_API_KEY=
